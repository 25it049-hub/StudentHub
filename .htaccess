# =============================================================================
# CHARUSAT StudentHub — Production Apache Server Configuration (.htaccess)
# =============================================================================

# 1. Custom Error Pages
ErrorDocument 404 /404.html

# 2. MIME Types for Static Assets (Ensures CSS, JS, Images, and JSON load properly)
<IfModule mod_mime.c>
    AddType text/css .css
    AddType application/javascript .js
    AddType image/svg+xml .svg
    AddType image/png .png
    AddType image/jpeg .jpg .jpeg
    AddType image/x-icon .ico
    AddType application/json .json
</IfModule>

# 3. Security: Block Sensitive Files (.env, database dumps, logs)
<FilesMatch "^\.(env|git|htaccess|system)|(registrations\.json|audit_logs\.json|contacts\.(json|csv)|feedback\.(json|csv)|\.sql)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# 4. Security Headers (where supported)
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
